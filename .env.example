# Name shown in the app.
PLATFORM_NAME=CallMate

# ElevenLabs runs the voice and the AI (Claude Haiku 5.5) and bills you for both.
ELEVENLABS_API_KEY=
# The AI that does the talking (any LLM ElevenLabs agents support).
AGENT_LLM=claude-haiku-5-5
# Low-latency multilingual voice model.
TTS_MODEL=eleven_flash_v2_5

# Your USDT receiving wallets. Leave one empty to turn that network off.
USDT_TRC20_ADDRESS=
USDT_BEP20_ADDRESS=
# Optional: TronGrid API key (higher rate limits) and a BSC RPC node that
# allows eth_getLogs (public nodes often don't; paste-the-hash still works).
TRONGRID_API_KEY=
BSC_RPC_URL=

# SQLite file. Created on first run.
DATABASE_PATH=./data/app.db

# What customers pay per minute of call, in USD (= USDT).
PRICE_PER_MINUTE_USD=0.20
# Longest single call, in seconds.
MAX_CALL_SECONDS=1800
# Free credit for new accounts, in USD.
SIGNUP_CREDIT_USD=0
MIN_DEPOSIT_USD=3
MAX_CLONES_PER_ACCOUNT=1
