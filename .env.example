# Name shown in the UI and used inside the setup assistant prompt.
PLATFORM_NAME=Practice Voice

# Claude (setup assistant + scenario safety check).
ANTHROPIC_API_KEY=

# ElevenLabs (voice agents). Each saved scenario becomes its own ElevenLabs agent.
ELEVENLABS_API_KEY=

# SQLite file. Created on first run.
DATABASE_PATH=./data/app.db

# Pricing charged to customers, in US dollars.
PRICE_PER_MINUTE_USD=0.05
# Multiplier applied to Claude token cost before deducting it from credits.
LLM_MARKUP=1.5
# Free credit given to every new account.
SIGNUP_CREDIT_USD=1.00
# Hard cap on a single practice call, in seconds.
MAX_CALL_SECONDS=900

# Optional: JSON list of allowed voices, e.g. [{"id":"21m00Tcm4TlvDq8ikWAM","name":"Rachel","description":"Calm, female"}]
# VOICES_JSON=
