# ---------------------------------------------------------------------------
# Courier — environment configuration. Copy to .env and fill in real values.
# NEVER commit .env. Placeholders below are not real credentials.
# See DEPLOYMENT.md for where each value comes from on Namecheap cPanel.
# Defaults target a US-based business shipping internationally (USD, America/New_York,
# lb/in); change them in Admin → System settings.
# ---------------------------------------------------------------------------

APP_NAME="Your Courier Name"
APP_ENV=production            # local | production
APP_KEY=                      # generate with: php artisan key:generate
APP_DEBUG=false               # MUST be false in production
APP_URL=https://yourdomain.com
APP_TIMEZONE=UTC              # stored timestamps are UTC; display timezone is set in Admin → Settings

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Only set if the site sits behind a proxy/CDN you control (e.g. Cloudflare): comma-separated IPs/CIDRs, or *.
TRUSTED_PROXIES=

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# --- Database (cPanel → MySQL Databases) ---
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpaneluser_courier
DB_USERNAME=cpaneluser_courier
DB_PASSWORD=change-me

# --- Sessions / cache / queue (database-backed: works on shared hosting) ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true    # set false only for local http development
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# --- Payments ---
# stripe   = Stripe Checkout — cards, Apple Pay, Google Pay (US & international). Recommended.
# paystack = Paystack (Africa)
# sandbox  = development only, clearly labelled, no money moves (refused when APP_ENV=production)
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=              # Stripe Dashboard → Developers → API keys (starts with sk_test_ / sk_live_)
STRIPE_PUBLISHABLE_KEY=         # starts with pk_test_ / pk_live_
STRIPE_WEBHOOK_SECRET=          # Developers → Webhooks → your endpoint → Signing secret (starts with whsec_)
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
PAYMENT_PENDING_TTL_MINUTES=60

# --- Address search & maps ---
# google = Google Places autocomplete + Google map preview (needs GOOGLE_MAPS_API_KEY)
# osm    = OpenStreetMap search via Photon (free, fair use — fine for testing/low volume)
# none   = manual address entry only
ADDRESS_AUTOCOMPLETE=google
GOOGLE_MAPS_API_KEY=            # BROWSER key: restrict to your domain + "Maps JavaScript API" and "Places API (New)"
OSM_AUTOCOMPLETE_URL=https://photon.komoot.io/api/

# --- Email (cPanel → Email Accounts → Connect Devices shows these, or use Namecheap Private Email) ---
MAIL_MAILER=smtp              # use "log" in development (emails written to storage/logs)
MAIL_SCHEME=smtps
MAIL_HOST=mail.yourdomain.com
MAIL_PORT=465
MAIL_USERNAME=no-reply@yourdomain.com
MAIL_PASSWORD=change-me
MAIL_FROM_ADDRESS="no-reply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"
SUPPORT_EMAIL=support@yourdomain.com
SUPPORT_PHONE=
WHATSAPP_NUMBER=               # e.g. 2348030000000 — shows a floating WhatsApp chat button (also editable in Admin → Settings)

# --- SMS ---
# log    = development: messages are written to the log, nothing is sent
# twilio = Twilio (US & international). US traffic needs A2P 10DLC or toll-free verification.
# termii = Termii (Africa)
SMS_DRIVER=twilio
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=                    # e.g. +12125550100 (a Twilio number) — or use a Messaging Service:
TWILIO_MESSAGING_SERVICE_SID=
TERMII_API_KEY=
TERMII_SENDER_ID=
TERMII_BASE_URL=https://api.ng.termii.com
TERMII_CHANNEL=generic

# --- Maps (Leaflet). Any XYZ tile URL. The default public OSM server has a strict usage
# policy — use a commercial provider (e.g. MapTiler, Stadia, Thunderforest) in production.
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION="&copy; OpenStreetMap contributors"

# --- Uploads (proof-of-delivery photos). Stored privately in storage/app/private.
UPLOAD_MAX_KB=5120

VITE_APP_NAME="${APP_NAME}"
